# Local dev runs only on loopback without a token. Production/non-loopback requires a token.
HOST=127.0.0.1
PORT=3002
ORGANIZER_TOKEN=
DATA_DIR=.data
LIVE_AI_ENABLED=false
SIDE_EFFECTS_ENABLED=false
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
BACKBOARD_DOCUMENT_IDS=
BACKBOARD_MODEL_PROVIDER=
BACKBOARD_MODEL=
# Live plan request deadline; bounded to 10000-60000 ms. Discord execution remains 15 seconds.
BACKBOARD_PLAN_TIMEOUT_MS=45000
# Set only after verifying current billing and a conservative maximum cost per plan.
SESSION_COST_LIMIT=
BACKBOARD_MAX_COST_PER_PLAN=
COMPOSIO_API_KEY=
COMPOSIO_CALENDAR_ACCOUNT=
COMPOSIO_CALENDAR_VERSION=
GOOGLE_CALENDAR_ID=primary
COMPOSIO_DISCORD_ACCOUNT=
COMPOSIO_DISCORD_VERSION=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_LABEL=announcements
# If configured, webhook is the Discord transport; never exposed to the browser.
DISCORD_WEBHOOK_URL=
